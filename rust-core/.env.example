# Copy to .env (or export these as real environment variables) before
# running `iod-server`. All have working defaults if unset.

# Address the Rust HTTP API binds to.
IOD_BIND_ADDR=127.0.0.1:8787

# Path to the SQLite database file (created automatically if missing).
IOD_DB_PATH=iod_simulation.db

# Administrator token for POST /api/trace/request (X-Admin-Token header). >=16 chars; if unset nobody is an administrator.
IOD_ADMIN_TOKEN=

# --- Steganographic image transport (application messages) ---
# Python image service (loopback http only; TLS intentionally unsupported)
IOD_PYTHON_URL=http://127.0.0.1:5001
# Directory shared by the Rust core and the Python service for saved PNGs
IOD_STEGO_ARTIFACT_DIR=./data/stego-artifacts
IOD_STEGO_CAMERA_INDEX=0
IOD_STEGO_CAPTURE_TIMEOUT_MS=3000
IOD_STEGO_MAX_WIDTH=1920
IOD_STEGO_MAX_HEIGHT=1080
IOD_STEGO_MAX_FRAME_BYTES=65536
IOD_STEGO_HTTP_TIMEOUT_MS=20000
# Selector hard limits (policy sel-policy-1)
# IOD_STEGO_MAX_MSE=4.0
# IOD_STEGO_MIN_PSNR_DB=40.0
# IOD_STEGO_MAX_COST_UNITS=1000
