# Copy to .env before running the Python RAG service. Has working
# defaults if unset.

# Port the Flask app listens on.
IOD_PYTHON_PORT=5001

# Interface the Flask app binds to. Leave as 127.0.0.1 for native runs
# (everything on one machine); the Docker image overrides this to
# 0.0.0.0 so other containers can reach it (see python-service/Dockerfile).
IOD_PYTHON_HOST=127.0.0.1

# --- Steganography service ---
# Must be the same directory the Rust core uses (IOD_STEGO_ARTIFACT_DIR)
IOD_STEGO_ARTIFACT_DIR=./data/stego-artifacts
# 0 = keep every artifact (default). N > 0 keeps only the newest N image pairs.
IOD_STEGO_RETENTION_MAX_ARTIFACTS=0
# auto = try the webcam then fall back to the procedural generator; disabled = always procedural
IOD_STEGO_CAMERA=auto
