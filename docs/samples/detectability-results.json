  "quality_score_mean": 0.9465337500000001
 },
 "detector": {
  "model": "standardisation + L2 logistic regression (Newton/IRLS), implemented in this script with NumPy",
  "l2": 1.0,
  "features": [
   {
    "name": "spam1[49]",
    "definition": "first-order co-occurrence of horizontally/vertically adjacent pixel differences truncated to [-3,3], averaged over both directions and all channels (7x7 normalised counts)"
   },
   {
    "name": "lsb_ones",
    "definition": "fraction of ones in the least-significant bit plane"
   },
   {
    "name": "lsb_corr_h / lsb_corr_v",
    "definition": "correlation of the LSB plane with its right / lower neighbour"
   },
   {
    "name": "lsb_msb_corr",
    "definition": "correlation between bit 0 and bit 1"
   },
   {
    "name": "pov_chi2",
    "definition": "pairs-of-values chi-square statistic of the histogram, divided by the number of populated pairs"
   },
   {
    "name": "hist_pair_diff",
    "definition": "mean |h[2k]-h[2k+1]| / (h[2k]+h[2k+1]) over populated pairs"
   },
   {
    "name": "hcf_com",
    "definition": "centre of mass of the histogram characteristic function (|DFT| of the 256-bin histogram)"
   },
   {
    "name": "hist_smooth",
    "definition": "mean absolute second difference of the normalised histogram"
   },
   {
    "name": "hp_std / hp_mad / hp_kurt",
    "definition": "standard deviation, mean absolute value and kurtosis of a 3x3 high-pass (KV-style) residual"
   },
   {
    "name": "d1_std / d1_kurt",
    "definition": "standard deviation and kurtosis of first differences"
   },
   {
    "name": "d2_mad",
    "definition": "mean absolute second difference"
   },
   {
    "name": "block8",
    "definition": "8x8 blockiness: mean |difference| across block boundaries divided by the same inside blocks"
   },
   {
    "name": "parity_run",
    "definition": "mean run length of equal LSBs along rows"
   }
  ],
  "feature_count": 65
 },
 "protocol": {
  "split": "grouped 5-fold by seed; leave-one-family-out",
  "confidence_intervals": "percentile bootstrap, 1000 resamples of seeds",
  "threshold": 0.5,
  "payload": "uniformly random bytes (ciphertext-like)",
  "rng_seed": 20261115
 },
