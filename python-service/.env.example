# Copy to .env before running the Python RAG service. Has working
# defaults if unset.

# Port the Flask app listens on.
IOD_PYTHON_PORT=5001

# Interface the Flask app binds to. Leave as 127.0.0.1 for native runs
# (everything on one machine); the Docker image overrides this to
# 0.0.0.0 so other containers can reach it (see python-service/Dockerfile).
IOD_PYTHON_HOST=127.0.0.1
