# Copy to .env (or export these as real environment variables) before
# running `iod-server`. All have working defaults if unset.

# Address the Rust HTTP API binds to.
IOD_BIND_ADDR=127.0.0.1:8787

# Path to the SQLite database file (created automatically if missing).
IOD_DB_PATH=iod_simulation.db

# Administrator token for POST /api/trace/request (X-Admin-Token header). >=16 chars; if unset nobody is an administrator.
IOD_ADMIN_TOKEN=

# --- Steganographic image transport (application messages) ---
# Python image service (loopback http only; TLS intentionally unsupported)
IOD_PYTHON_URL=http://127.0.0.1:5001
# Directory shared by the Rust core and the Python service for saved PNGs
IOD_STEGO_ARTIFACT_DIR=./data/stego-artifacts
IOD_STEGO_MAX_WIDTH=1920
IOD_STEGO_MAX_HEIGHT=1080
IOD_STEGO_MAX_FRAME_BYTES=65536
IOD_STEGO_HTTP_TIMEOUT_MS=20000
# --- Patch-wise transport (docs/patchwise-transport.md section 7). Unset = service defaults. ---
# IOD_STEGO_SEG_MIN_REGION_PX=256
# IOD_STEGO_SEG_MAX_REGIONS=96
# IOD_STEGO_SEG_MAX_REGION_FRAC=0.35
# IOD_STEGO_SEG_CELL_SIZE=0
# IOD_STEGO_SEG_W_INTENSITY=1.0
# IOD_STEGO_SEG_W_TEXTURE=1.0
# IOD_STEGO_SEG_W_GRADIENT=0.6
# IOD_STEGO_SEG_W_COLOR=0.5
# IOD_STEGO_SEG_TAU_ITERATIONS=7
# IOD_STEGO_SEG_MAX_REFINE_LEVELS=3
# IOD_STEGO_TARGET_CHUNK_BYTES=48
# IOD_STEGO_MAX_REPLANS=2
# --- Cover generation (docs/patchwise-transport.md section 2a) ---
# Every transmission uses a fresh cover generated locally (procedural noise, NumPy only: no camera, no upload,
# no pretrained model, no network). The profile sets conservative RESOURCE limits; a request can only tighten them.
# Set the SAME values for the Rust core and the Python image service: both validate.
# raspberry_pi_5_cpu (default): 320x240 RGB, ceiling 640x480 / 307200 px, 2 candidates, 2500 ms, 96 MB, 1 worker.
# development_host: 480x360, ceiling 1280x960, 4 candidates, 8000 ms, 512 MB.
IOD_STEGO_GENERATOR_PROFILE=raspberry_pi_5_cpu
# Optional overrides of the profile (bounded by hard ceilings: 1920x1080, 8 candidates, 30000 ms, 1024 MB, 1 worker).
# IOD_STEGO_GENERATOR_WIDTH=320
# IOD_STEGO_GENERATOR_HEIGHT=240
# IOD_STEGO_GENERATOR_MAX_WIDTH=640
# IOD_STEGO_GENERATOR_MAX_HEIGHT=480
# IOD_STEGO_GENERATOR_MAX_PIXELS=307200
# IOD_STEGO_GENERATOR_MAX_CANDIDATES=2
# IOD_STEGO_GENERATOR_BUDGET_MS=2500
# IOD_STEGO_GENERATOR_MAX_MEMORY_MB=96
# IOD_STEGO_GENERATOR_MIN_QUALITY=0.70
# IOD_STEGO_GENERATOR_MAX_EMBED_RATE=0.20
# IOD_STEGO_GENERATOR_ALLOW_RESIZE=false
# IOD_STEGO_GENERATOR_FAMILIES=terrain,clouds,strata,cells
# IOD_STEGO_GENERATOR_WORKERS=1
# IOD_STEGO_GENERATOR_MODE=RGB
