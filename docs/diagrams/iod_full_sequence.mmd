%% IOD full-technical sequence diagram.
%% Notation rules (binding for this file):
%%   - "||" denotes byte-string concatenation (transcripts, HKDF/HMAC inputs).
%%   - Poseidon calls always use comma style: Poseidon(a, b, c), never "||".
%%   - Every wire message is drawn with its FULL field list, braced: Msg{f1, f2, ...}.
%%   - RAG / the stego-selection subsystem is registration-local only: it
%%     never appears as its own participant/swimlane and never receives a
%%     network arrow. It is shown as a Note attached to the party doing the
%%     selection (D1 at R1, GCS at R3), matching its real architecture: a
%%     library call inside that party's own process, not a remote service
%%     from the protocol's point of view.
%%   - R2 is GCS-internal processing: no arrow ever leaves or enters GCS for
%%     it, it is shown as a Note over GCS only.
%%   - Trace Manager appears ONLY inside an alt/exception block (it is an
%%     audit/administrative path, never part of the happy path).
sequenceDiagram
    autonumber
    participant D1 as Drone D1
    participant GCS as Ground Control Station (GCS)
    participant D2 as Drone D2

    Note over D1,GCS: Registration (R1-R3), post-quantum sealed, steganographically transported

    D1->>D1: reference_reading = PUF.read(), enrolled = FuzzyExtractor.generate(reference_reading)
    D1->>D1: rho = derive_puf_bound_rho(puf_seed) = HKDF(puf_seed, salt, "IOD-SEED-LEAF-RHO-v1", 32) [spec 25-C: PUF<->credential<->Merkle-member<->ML-DSA-key binding]
    D1->>D1: L_D1,G = Poseidon(PK_KEM_D1, PK_Dil_D1, G, metadata, rho)

    rect rgb(235,240,255)
    Note over D1: RAG-assisted stego selection (registration-local, never a network party)<br/>1. stego.benchmark.measure_all(cover_image, payload) -&gt, real embed/extract time, capacity, PSNR, SSIM for {adaptive_lsb, pvd, dct, dwt, svd}<br/>2. rag.selector.select_algorithm(measurements, importance=CRITICAL) -&gt, deterministic winner (feasibility gate: capacity &gt,= payload_size, importance-weighted score, alphabetical tie-break)<br/>3. rag.stego_knowledge.explain_selection(measurements, winner) -&gt, narrative that only quotes the measurement dict just produced (cannot fabricate a number)
    end

    D1->>GCS: EnrollmentRequest{msg_type, drone_id, g, pk_kem_d, pk_dil_d, membership_metadata_d, rho, pid_pool} || sealed via KEM-then-AEAD (envelope::seal_for_recipient, domain "R1-EnrollmentRequest") || embedded into a cover image by the winning stego algorithm

    Note over GCS: R2 (GCS-internal processing -- no message leaves or enters GCS for this step)<br/>leaf = Poseidon(pk_kem_d, pk_dil_d, g, membership_metadata_d, rho)<br/>tree.register(drone_id, leaf) -&gt, (R_G, V_G, witness{siblings, path_indices, leaf_index})<br/>pid_pool entries stored as PidState::Active (spec 25-F)

    rect rgb(235,240,255)
    Note over GCS: RAG-assisted stego selection for the R3 response (registration-local, same selector/benchmark/knowledge pipeline as R1, run inside GCS's own process)
    end

    GCS->>D1: EnrollmentResponse{msg_type, g, r_g, v_g, witness{siblings, path_indices, leaf_index}, pk_kem_gcs} || sealed via KEM-then-AEAD (domain "R3-EnrollmentResponse") || embedded into a cover image

    D1->>D1: leaf' = Poseidon(pk_kem_d, pk_dil_d, g, metadata, rho), verify_witness(r_g, leaf', witness) -- reject (StegoRegistrationError::WitnessVerificationFailed) if false [D1 no longer blindly trusts R3]

    Note over D1,D2: Authentication (M1-M8)

    D1->>D2: CommReq{msg_type, g, pid1, ts1, n1}
    D2->>GCS: CredReq{msg_type, g, pid1, d2_id, ts2, n2} || sealed via KEM-then-AEAD (domain "M2-CredReq")
    GCS->>GCS: d2_record checked active + same group, d1_id = consume_pid(pid1) -- PidState Active -&gt, Consumed, a replayed, already-consumed pid1 is rejected here [spec 25-F]
    GCS->>GCS: d2_cert = SignedPeerCert{pk_kem: d2_record.kem_pk, pk_dil: d2_record.dil_pk, ts, sig: Sign(gcs_sign_sk, pk_kem || pk_dil || ts)} [spec 25-A trust anchor for D2's key]
    GCS->>D2: CredResp{msg_type, cred_d1{pk_kem_d1, pk_dil_d1, membership_metadata_1, r_g, v_g, crp_challenge}, d2_cert{pk_kem, pk_dil, ts, sig}, ts3, n3} || sealed via KEM-then-AEAD (domain "M3-CredResp")
    D2->>D1: Challenge{challenge_payload{msg_type, g, c_puf, n2, ts4, ct_kem_d2d1}, sig4, d2_cert{pk_kem, pk_dil, ts, sig}}
    D1->>D1: verify Sign(gcs_sign_pk, d2_cert) first, only then verify sig4 against d2_cert.pk_dil [spec 25-A -- a self-asserted, uncertified key is rejected here, before sig4 is even checked]
    D1->>D1: k_puf = HKDF(PUF.challenge_response(c_puf), "", "IOD-SEED-PUF-MAC-v1", 32)
    D1->>D1: comm_PK_D1 = Poseidon(PK_KEM_D1, PK_Dil_D1)
    D1->>D1: T_base = G || V_G || R_G || comm_PK_D1 || N1 || N2 || ts1 || ts4 || PID1, mac1 = HMAC(k_puf, T_base)
    D1->>D1: proof_zk = ZK.prove(statement{g, r_g, v_g, comm_pk}, witness{leaf, siblings, path_indices, pk_kem, pk_dil, metadata, rho})
    D1->>D1: T = G || V_G || R_G || comm_PK_D1 || digest(proof_zk) || N1 || N2 || ts1 || ts4 || PID1, sig1 = Sign(dil_sk_d1, T)
    D1->>D2: ProofBundle{msg_type, pid1, comm_pk_d1, proof_zk, mac1, sig1, pk_dil_d1, pk_kem_d1, ts5, n5, ct_kem_d1d2}
    D2->>GCS: PUFVerifyReq{msg_type, pid1, g, v_g, c_puf, n2, t_base, mac1} || sealed via KEM-then-AEAD (domain "M6-PUFVerifyReq")
    GCS->>GCS: reject if n2 in used_nonces (replay), else k_puf_ref = HKDF(crp.reference_response, ...), result = (HMAC-verify(k_puf_ref, t_base, mac1) ? Valid : Invalid)
    GCS->>D2: PUFVerifyResp{payload{msg_type, pid1, result, ts7, current_r_g, current_v_g}, sig7}
    D2->>D2: recomputed_comm_pk = Poseidon(pk_kem_d1, pk_dil_d1), credential_consistency_ok = (recomputed_comm_pk == comm_pk_d1) AND (pk_kem_d1 == cred_d1.pk_kem_d1) AND (pk_dil_d1 == cred_d1.pk_dil_d1) [spec 25-B]
    D2->>D2: m7_verify_and_decide -&gt, VerificationReport{freshness_ok, zk_membership_ok, signature_ok, puf_ok, root_version_ok, credential_consistency_ok, zero_trust, reason_code}

    alt zero_trust = Deny
        D2->>GCS: (administrative) TraceManager.flag_session(session_id, drone_id, reason_code)
        Note over GCS: Trace Manager (audit-only path): flag recorded unconditionally, PID -&gt, DroneID resolution granted only when requester_role == "administrator", every resolution ATTEMPT (authorized or not) is appended to the audit trail
    end

    D2->>D1: AuthResult{payload9{msg_type, result, reason_code, ts9, n9}, sig9, d2_cert{pk_kem, pk_dil, ts, sig}}
    D1->>D1: verify Sign(gcs_sign_pk, d2_cert), only then verify sig9 against d2_cert.pk_dil -- uses ONLY this message + gcs_sign_pk, no lookup into D2's own state [spec 25-G: self-contained M8 verification]

    Note over D1,D2: Group Key Establishment (K1-K4)

    D2->>GCS: GroupKeyReq{msg_type, g, d1_pid1, d2_id, mission_id, ts6, n6, auth_evidence_hash} || sealed via KEM-then-AEAD (domain "K1-GroupKeyReq")
    GCS->>GCS: require AuthSessionRecord{session_id, n1, n2, decision} on file for (d1_pid1, d2_id) with decision == Allow -- else reject [spec 25-D/25-I: K1 bound to a genuinely-completed M1-M8 session]
    GCS->>GCS: K_G,M = random(32 bytes), env_D1 = seal(pk_kem_d1, K_G,M || g || mission_id || ts7), env_D2 = seal(pk_kem_d2, K_G,M || g || mission_id || ts7)
    GCS->>D2: GroupKeyResp{msg_type, ct_kem_g_d1, ct_kem_g_d2, ts7, n7} || outer transport seal (domain "K1-GroupKeyResp-transport")
    D2->>D1: KeyDelivery{payload8{msg_type, ct_kem_g_d1, ts8, n8}, sig8, pk_dil_d2}
    D1->>D1: K_AEAD = HKDF(K_G,M, "", "IOD-SEED-GROUPKEY-AEAD-v1" || (N1 || N2 || N6 || N7)) -- real session nonces from THIS session's M1/M2/K1/K1-response, never placeholders [spec 25-E]

    Note over D1,D2: Secure Application Messaging

    D1->>D2: SecureAppMessage{header_seq, header_ts, src_pid, dst_pid, sealed} -- src_pid/dst_pid = SHAKE256-derived session tags (tag_a, tag_b) over K_AEAD, never the permanent DroneID [spec 25-H]

    alt Revocation and denied re-authentication
        GCS->>GCS: revoke_drone(drone_id): DronePublicRecord.active = false, GroupMembershipTree.revoke(drone_id) -- leaf zeroed, V_G += 1
        D1->>D2: CommReq{msg_type, g, pid1, ts1, n1} (re-authentication attempt)
        D2->>GCS: CredReq{msg_type, g, pid1, d2_id, ts2, n2}
        GCS--xD2: reject -- "D1 is revoked" (M3 refuses to issue cred_d1, session never reaches M4-M8)
    end
