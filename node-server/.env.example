# Copy to .env before running the Node gateway. All have working
# defaults if unset (see src/config.ts).

# Port the Node gateway listens on.
IOD_NODE_PORT=4000

# Base URL of the Rust core HTTP API.
IOD_RUST_BASE_URL=http://127.0.0.1:8787

# Base URL of the Python RAG service.
IOD_PYTHON_BASE_URL=http://127.0.0.1:5001

# How often (ms) the Node gateway polls the Rust core for new events
# before relaying them to the browser over Server-Sent Events.
IOD_EVENT_POLL_MS=500
